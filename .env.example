# ============================================================================
# Asesor de viajes multi-agente — variables de entorno (entrega final)
# Copiá este archivo como .env y completá tus claves. El .env está en .gitignore: NUNCA se sube.
# Todas se validan al arrancar (config.py, pydantic-settings): un valor inválido falla con un mensaje claro.
# Sin claves podés correr TODO en modo mock: MODO_MOCK=1
# ============================================================================

# --- LLM: Claude (https://console.anthropic.com -> API Keys) ------------------
ANTHROPIC_API_KEY=
# Modelo que usan los cuatro roles (supervisor, investigador, analista, síntesis)
ANTHROPIC_MODEL=claude-haiku-5-5
# Tope de tokens de salida por llamada, timeout (s) y reintentos ante 429/5xx
MAX_TOKENS_RESPUESTA=8000
LLM_TIMEOUT_S=90
LLM_MAX_REINTENTOS=3

# --- Búsqueda web: Tavily (https://app.tavily.com -> API Keys) ----------------
TAVILY_API_KEY=
TAVILY_MAX_RESULTADOS=3

# --- Modo mock: LLM con políticas + Tavily simulado + embeddings offline -------
# 1 = sin claves ni descargas (demo y tests). 0 = real.
MODO_MOCK=0

# --- RAG: base de conocimiento de guías (Wikivoyage ES, data/guias/) ---------
# Carpeta del corpus (markdown con encabezado YAML) — relativa a la raíz del repo
GUIAS_DIR=data/guias
# Vector store: chroma (local, sin claves, por defecto) | pinecone (serverless)
VECTOR_STORE=chroma
# Chroma: carpeta del índice persistente y nombre de la colección
CHROMA_DIR=data/indice_chroma
GUIAS_COLECCION=guias_viaje
# Pinecone (solo si VECTOR_STORE=pinecone): el índice se crea solo si no existe
PINECONE_API_KEY=
PINECONE_INDEX=guias-viaje
PINECONE_NAMESPACE=guias
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Modelo de embeddings (fastembed, ONNX sin torch). Cambiarlo reindexa solo (la ingesta compara la huella).
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Dónde se descargan los modelos ONNX (fuera del repo). Vacío = ~/.cache/asesor-viajes/modelos
# MODELOS_CACHE_DIR=
# Chunking por tokens (con el tokenizer del modelo de embeddings)
CHUNK_TOKENS=500
CHUNK_OVERLAP=60
# Recuperación: fragmentos que devuelve consultar_guias, candidatos de cada buscador (BM25 y vectorial) y k de RRF
RAG_TOP_K=4
RAG_CANDIDATOS=20
RAG_RRF_K=60
# Re-ranking: cross_encoder (ONNX multilingüe, gratis) | llm (Claude puntúa, gasta tokens) | ninguno
RERANKER=cross_encoder
RERANKER_MODELO=jinaai/jina-reranker-v2-base-multilingual
# Cuántos candidatos fusionados re-ordena y cuánto texto de cada uno lee (la latencia en CPU depende de esto)
RERANKER_CANDIDATOS=12
RERANKER_MAX_CARACTERES=1200
# Ingesta idempotente al arrancar la API (solo indexa lo nuevo o lo que cambió)
INGESTA_AL_ARRANCAR=true

# --- Memoria de búsquedas web (ChromaDB): caché semántico de Tavily ----------
MEMORIA_DIR=data/memoria_chroma
MEMORIA_COLECCION=busquedas_viajes
# Un dato de la web vale estos días (precios y cotizaciones cambian)
MEMORIA_MAX_DIAS=7
# Distancia coseno máxima para que un dato guardado "sirva" (calibrada con chroma-default)
MEMORIA_MAX_DISTANCIA=0.55
# chroma-default = all-MiniLM-L6-v2 de ChromaDB; o un modelo de fastembed (recalibrar el umbral)
MEMORIA_EMBEDDINGS=chroma-default

# --- Frenos del grafo (anti "supervisor infinito") ----------------------------
MAX_PASOS_SUPERVISOR=6
RECURSION_LIMIT=20
RECURSION_LIMIT_ESPECIALISTA=12

# --- API, Redis y worker ------------------------------------------------------
# Redis 8+ o Redis Stack (RedisJSON + RediSearch: los necesita el checkpointer de LangGraph).
# docker compose lo pone solo (redis://redis:6379/0). Local: redis://localhost:6379/0
# Redis Cloud: redis://default:<password>@<host>:<puerto>/0
# Vacío = fakeredis en memoria + InMemorySaver (solo para probar: nada sobrevive a un reinicio)
REDIS_URL=
# Tope de conexiones a Redis (Redis Cloud gratis admite 30 clientes)
REDIS_MAX_CONEXIONES=20
# Cuántos grafos corren a la vez (el resto espera en PENDING) y tope de segundos por tramo
MAX_JOBS_CONCURRENTES=5
JOB_TIMEOUT_S=900
# Los checkpoints de una conversación se borran solos después de estos minutos (7 días)
CHECKPOINT_TTL_MINUTOS=10080

# --- Observabilidad: LangSmith (https://smith.langchain.com -> Settings -> API Keys) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=entrega-final
# Solo si tu cuenta es de otra región (EU: https://eu.api.smith.langchain.com). Vacío = la de EE. UU.
LANGSMITH_ENDPOINT=
